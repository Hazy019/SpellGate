rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if the request is from the paired anonymous child device
    function isPairedDevice(userId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(userId)/child_data/settings) &&
             request.auth.uid == get(/databases/$(database)/documents/users/$(userId)/child_data/settings).data.paired_device_uid;
    }

    // ── User data: only the parent owner OR the paired child device can read/write ──
    match /users/{userId}/{document=**} {
      allow read, update, delete: if
        request.auth != null && (
          request.auth.uid == userId ||
          isPairedDevice(userId)
        );

      allow create: if
        request.auth != null &&
        request.auth.uid == userId;
    }

    // ── Pairing codes: temporary 5-minute intake documents ──
    match /pairing_codes/{code} {
      allow read, write: if request.auth != null;
    }

  }
}

