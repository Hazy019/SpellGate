rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if the request is from the paired anonymous child device
    function isPairedDevice(userId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(userId)/child_data/settings) &&
             request.auth.uid == get(/databases/$(database)/documents/users/$(userId)/child_data/settings).data.paired_device_uid;
    }

    // ── User data: only the verified parent owner OR the paired child device can read/write ──
    match /users/{userId}/{document=**} {
      allow read, update, delete: if
        request.auth != null && (
          (request.auth.uid == userId && request.auth.token.email_verified == true) ||
          isPairedDevice(userId)
        );

      allow create: if
        request.auth != null &&
        request.auth.uid == userId;
    }

    // ── Pairing codes: parents create/delete, child apps read/update to set device_uid
    match /pairing_codes/{code} {
      allow create: if
        request.auth != null &&
        request.resource.data.parent_uid == request.auth.uid;
      
      allow get: if
        request.auth != null;
        
      allow list: if
        request.auth != null &&
        resource.data.parent_uid == request.auth.uid;
        
      allow update: if
        request.auth != null &&
        resource.data.device_uid == "";
        
      allow delete: if
        request.auth != null &&
        resource.data.parent_uid == request.auth.uid;
    }

  }
}

